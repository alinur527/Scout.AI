DATABASE_URL=sqlite:///./data/scoutai.db
# Run scripts/setup.ps1 to generate a private random key in backend/.env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=./data/uploads
MODEL_WEIGHTS=./weights/yolo11n-pose.pt
SCOUTAI_DEMO_MODE=true
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=1800
MAX_VIDEO_FRAMES=54000
JOB_RETENTION_DAYS=7
